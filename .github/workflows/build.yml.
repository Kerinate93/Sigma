# Положи этот файл в репозиторий GitHub как .github/workflows/build.yml
name: Build APK
on:
  push:
  workflow_dispatch:
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Android SDK
        run: |
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" "platforms;android-34" "build-tools;34.0.0" > /dev/null || true
      - name: Create project
        run: |
          mkdir -p .
          cat > settings.gradle <<'JAVAEOF'
          pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }
          dependencyResolutionManagement { repositories { google(); mavenCentral() } }
          rootProject.name = 'TraceOverlay'
          include ':app'
          JAVAEOF
          mkdir -p .
          cat > build.gradle <<'JAVAEOF'
          plugins { id 'com.android.application' version '8.5.2' apply false }
          JAVAEOF
          mkdir -p app
          cat > app/build.gradle <<'JAVAEOF'
          plugins { id 'com.android.application' }
          android {
              namespace 'app.trace'
              compileSdk 34
              defaultConfig {
                  applicationId 'app.trace.overlay'
                  minSdk 28
                  targetSdk 33
                  versionCode 1
                  versionName '1.0'
              }
              compileOptions {
                  sourceCompatibility JavaVersion.VERSION_1_8
                  targetCompatibility JavaVersion.VERSION_1_8
              }
          }
          JAVAEOF
          mkdir -p app/src/main
          cat > app/src/main/AndroidManifest.xml <<'JAVAEOF'
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
              <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
              <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
              <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
              <application
                  android:label="Шаблон для рисования"
                  android:theme="@android:style/Theme.Material.Light.NoActionBar">
                  <activity android:name=".MainActivity" android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>
                  <activity
                      android:name=".PickActivity"
                      android:exported="false"
                      android:excludeFromRecents="true"
                      android:taskAffinity=""
                      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
                  <service android:name=".OverlayService" android:exported="false" />
              </application>
          </manifest>
          JAVAEOF
          mkdir -p app/src/main/java/app/trace
          cat > app/src/main/java/app/trace/MainActivity.java <<'JAVAEOF'
          package app.trace;

          import android.app.Activity;
          import android.content.Intent;
          import android.content.pm.PackageManager;
          import android.net.Uri;
          import android.os.Build;
          import android.os.Bundle;
          import android.provider.Settings;
          import android.view.View;
          import android.widget.Button;
          import android.widget.LinearLayout;
          import android.widget.ScrollView;
          import android.widget.TextView;
          import android.widget.Toast;

          public class MainActivity extends Activity {
              @Override protected void onCreate(Bundle b) {
                  super.onCreate(b);
                  if (Build.VERSION.SDK_INT >= 33
                          && checkSelfPermission("android.permission.POST_NOTIFICATIONS") != PackageManager.PERMISSION_GRANTED)
                      requestPermissions(new String[]{"android.permission.POST_NOTIFICATIONS"}, 1);
                  int p = Math.round(20 * getResources().getDisplayMetrics().density);
                  LinearLayout box = new LinearLayout(this);
                  box.setOrientation(LinearLayout.VERTICAL);
                  box.setPadding(p, p, p, p);
                  TextView t = new TextView(this);
                  t.setTextSize(16);
                  t.setText("Шаблон для рисования\n\n1. Разреши показ поверх других приложений.\n"
                          + "2. Выбери фото: оно появится поверх экрана полупрозрачным.\n"
                          + "3. Открой Gartic Phone. В панели меняй прозрачность и размер. "
                          + "«Двигать» переставляет фото, «Рисовать» пропускает касания сквозь него, "
                          + "так что рисуешь прямо в Gartic.\n");
                  box.addView(t);
                  box.addView(button("Разрешить поверх других приложений", v -> allow()));
                  box.addView(button("Выбрать фото", v -> {
                      if (Settings.canDrawOverlays(this)) {
                          startActivity(new Intent(this, PickActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
                      } else {
                          Toast.makeText(this, "Сначала разреши показ поверх других приложений", Toast.LENGTH_LONG).show();
                          allow();
                      }
                  }));
                  box.addView(button("Закрыть шаблон", v -> stopService(new Intent(this, OverlayService.class))));
                  ScrollView sv = new ScrollView(this);
                  sv.addView(box);
                  setContentView(sv);
              }

              Button button(String s, View.OnClickListener l) {
                  Button x = new Button(this);
                  x.setText(s);
                  x.setAllCaps(false);
                  x.setOnClickListener(l);
                  return x;
              }

              void allow() {
                  startActivity(new Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION, Uri.parse("package:" + getPackageName())));
              }
          }
          JAVAEOF
          mkdir -p app/src/main/java/app/trace
          cat > app/src/main/java/app/trace/PickActivity.java <<'JAVAEOF'
          package app.trace;

          import android.app.Activity;
          import android.content.Intent;
          import android.os.Bundle;
          import android.widget.Toast;
          import java.io.File;
          import java.io.FileOutputStream;
          import java.io.InputStream;

          public class PickActivity extends Activity {
              @Override protected void onCreate(Bundle b) {
                  super.onCreate(b);
                  if (b == null)
                      startActivityForResult(new Intent(Intent.ACTION_OPEN_DOCUMENT)
                              .addCategory(Intent.CATEGORY_OPENABLE).setType("image/*"), 1);
              }

              @Override protected void onActivityResult(int rq, int rs, Intent d) {
                  super.onActivityResult(rq, rs, d);
                  if (rs == RESULT_OK && d != null && d.getData() != null) {
                      boolean ok = false;
                      try (InputStream in = getContentResolver().openInputStream(d.getData());
                           FileOutputStream out = new FileOutputStream(new File(getFilesDir(), "tpl.img"))) {
                          byte[] buf = new byte[16384];
                          int n;
                          while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
                          ok = true;
                      } catch (Exception e) { }
                      if (ok) startForegroundService(new Intent(this, OverlayService.class).setAction("show"));
                      else Toast.makeText(this, "Не удалось открыть фото", Toast.LENGTH_LONG).show();
                  }
                  finish();
              }
          }
          JAVAEOF
          mkdir -p app/src/main/java/app/trace
          cat > app/src/main/java/app/trace/OverlayService.java <<'JAVAEOF'
          package app.trace;

          import android.app.Notification;
          import android.app.NotificationChannel;
          import android.app.NotificationManager;
          import android.app.PendingIntent;
          import android.app.Service;
          import android.content.Intent;
          import android.graphics.Bitmap;
          import android.graphics.ImageDecoder;
          import android.graphics.PixelFormat;
          import android.graphics.drawable.GradientDrawable;
          import android.os.IBinder;
          import android.view.Gravity;
          import android.view.MotionEvent;
          import android.view.ScaleGestureDetector;
          import android.view.View;
          import android.view.WindowManager;
          import android.view.WindowManager.LayoutParams;
          import android.widget.Button;
          import android.widget.ImageView;
          import android.widget.LinearLayout;
          import android.widget.SeekBar;
          import android.widget.TextView;
          import android.widget.Toast;
          import java.io.File;

          public class OverlayService extends Service {
              static final int WRAP = -2;
              static final int FL = LayoutParams.FLAG_NOT_FOCUSABLE | LayoutParams.FLAG_NOT_TOUCH_MODAL
                      | LayoutParams.FLAG_LAYOUT_IN_SCREEN | LayoutParams.FLAG_LAYOUT_NO_LIMITS;

              WindowManager wm;
              ImageView img;
              LayoutParams ip, pp;
              LinearLayout panel, body;
              SeekBar sbA, sbS;
              Button bMove, bHide;
              ScaleGestureDetector sgd;
              float aspect = 1f, opacity = .4f, lx, ly, px, py;
              boolean move, hidden, haveDrag;

              abstract static class Seek implements SeekBar.OnSeekBarChangeListener {
                  abstract void on(int p);
                  public void onProgressChanged(SeekBar s, int p, boolean user) { if (user) on(p); }
                  public void onStartTrackingTouch(SeekBar s) { }
                  public void onStopTrackingTouch(SeekBar s) { }
              }

              int dp(int n) { return Math.round(n * getResources().getDisplayMetrics().density); }
              int sw() { return getResources().getDisplayMetrics().widthPixels; }
              int sh() { return getResources().getDisplayMetrics().heightPixels; }

              @Override public IBinder onBind(Intent i) { return null; }

              @Override public int onStartCommand(Intent in, int flags, int id) {
                  NotificationManager nm = getSystemService(NotificationManager.class);
                  nm.createNotificationChannel(new NotificationChannel("t", "Шаблон", NotificationManager.IMPORTANCE_LOW));
                  PendingIntent stop = PendingIntent.getService(this, 0,
                          new Intent(this, OverlayService.class).setAction("stop"), PendingIntent.FLAG_IMMUTABLE);
                  startForeground(1, new Notification.Builder(this, "t")
                          .setSmallIcon(android.R.drawable.ic_menu_gallery)
                          .setContentTitle("Шаблон для рисования")
                          .setContentText("Нажми, чтобы закрыть шаблон")
                          .setContentIntent(stop).build());
                  if (in != null && "stop".equals(in.getAction())) { stopSelf(); return START_NOT_STICKY; }
                  try {
                      if (panel == null) build();
                      load();
                  } catch (Exception ex) {
                      Toast.makeText(this, "Нужно разрешение «Поверх других приложений»", Toast.LENGTH_LONG).show();
                      stopSelf();
                  }
                  return START_NOT_STICKY;
              }

              @Override public void onDestroy() {
                  try { wm.removeView(img); } catch (Exception e) { }
                  try { wm.removeView(panel); } catch (Exception e) { }
                  panel = null;
                  super.onDestroy();
              }

              void build() {
                  wm = getSystemService(WindowManager.class);

                  // Окно с фото. Пока NOT_TOUCHABLE, касания проходят сквозь него в Gartic.
                  // alpha < 0.8: Android 12+ не пропускает касания сквозь более плотные окна.
                  img = new ImageView(this);
                  img.setScaleType(ImageView.ScaleType.FIT_XY);
                  img.setAlpha(opacity);
                  ip = new LayoutParams(sw() / 2, sw() / 2, LayoutParams.TYPE_APPLICATION_OVERLAY,
                          FL | LayoutParams.FLAG_NOT_TOUCHABLE, PixelFormat.TRANSLUCENT);
                  ip.gravity = Gravity.TOP | Gravity.START;
                  ip.alpha = .79f;
                  sgd = new ScaleGestureDetector(this, new ScaleGestureDetector.SimpleOnScaleGestureListener() {
                      @Override public boolean onScale(ScaleGestureDetector d) {
                          resize(ip.width * d.getScaleFactor());
                          return true;
                      }
                  });
                  img.setOnTouchListener((v, e) -> {
                      sgd.onTouchEvent(e);
                      if (e.getPointerCount() > 1 || sgd.isInProgress()) {
                          haveDrag = false;
                      } else if (e.getActionMasked() == MotionEvent.ACTION_DOWN) {
                          lx = e.getRawX(); ly = e.getRawY(); haveDrag = true;
                      } else if (e.getActionMasked() == MotionEvent.ACTION_MOVE) {
                          if (haveDrag) {
                              ip.x += Math.round(e.getRawX() - lx);
                              ip.y += Math.round(e.getRawY() - ly);
                              wm.updateViewLayout(img, ip);
                          }
                          lx = e.getRawX(); ly = e.getRawY(); haveDrag = true;
                      } else {
                          haveDrag = false;
                      }
                      return true;
                  });
                  wm.addView(img, ip);

                  // Панель управления
                  panel = new LinearLayout(this);
                  panel.setOrientation(LinearLayout.VERTICAL);
                  GradientDrawable bg = new GradientDrawable();
                  bg.setColor(0xE62B1654);
                  bg.setCornerRadius(dp(14));
                  panel.setBackground(bg);
                  panel.setPadding(dp(10), dp(4), dp(10), dp(8));
                  panel.setMinimumWidth(dp(250));

                  LinearLayout head = new LinearLayout(this);
                  head.setGravity(Gravity.CENTER_VERTICAL);
                  TextView title = new TextView(this);
                  title.setText("☰ Шаблон");
                  title.setTextColor(0xFFFFFFFF);
                  title.setTextSize(15);
                  title.setPadding(0, dp(10), dp(10), dp(10));
                  title.setOnTouchListener((v, e) -> {
                      if (e.getActionMasked() == MotionEvent.ACTION_DOWN) {
                          px = e.getRawX(); py = e.getRawY();
                      } else if (e.getActionMasked() == MotionEvent.ACTION_MOVE) {
                          pp.x = Math.max(0, pp.x + Math.round(e.getRawX() - px));
                          pp.y = Math.max(0, pp.y + Math.round(e.getRawY() - py));
                          px = e.getRawX(); py = e.getRawY();
                          wm.updateViewLayout(panel, pp);
                      }
                      return true;
                  });
                  head.addView(title, new LinearLayout.LayoutParams(0, WRAP, 1f));
                  head.addView(btn("—", v -> body.setVisibility(body.getVisibility() == View.VISIBLE ? View.GONE : View.VISIBLE)));
                  head.addView(btn("✕", v -> stopSelf()));
                  panel.addView(head);

                  body = new LinearLayout(this);
                  body.setOrientation(LinearLayout.VERTICAL);
                  LinearLayout row = new LinearLayout(this);
                  Button bPick = btn("📷 Фото", v -> startActivity(
                          new Intent(this, PickActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)));
                  bMove = btn("✋ Двигать", v -> setMove(!move));
                  bHide = btn("👁 Скрыть", v -> {
                      hidden = !hidden;
                      img.setVisibility(hidden ? View.INVISIBLE : View.VISIBLE);
                      bHide.setText(hidden ? "👁 Показать" : "👁 Скрыть");
                      applyFlags();
                  });
                  for (Button x : new Button[]{bPick, bMove, bHide}) {
                      LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, WRAP, 1f);
                      lp.setMargins(dp(2), 0, dp(2), 0);
                      row.addView(x, lp);
                  }
                  body.addView(row);

                  body.addView(label("Прозрачность"));
                  sbA = new SeekBar(this);
                  sbA.setMax(100);
                  sbA.setProgress(Math.round(opacity * 100));
                  sbA.setOnSeekBarChangeListener(new Seek() {
                      void on(int p) { opacity = Math.max(.05f, p / 100f); img.setAlpha(opacity); }
                  });
                  body.addView(sbA);

                  body.addView(label("Размер"));
                  sbS = new SeekBar(this);
                  sbS.setMax(100);
                  sbS.setOnSeekBarChangeListener(new Seek() {
                      void on(int p) { resize(sw() * (.1f + 2.9f * p / 100f)); }
                  });
                  body.addView(sbS);
                  panel.addView(body);

                  pp = new LayoutParams(WRAP, WRAP, LayoutParams.TYPE_APPLICATION_OVERLAY, FL, PixelFormat.TRANSLUCENT);
                  pp.gravity = Gravity.TOP | Gravity.START;
                  pp.x = dp(8);
                  pp.y = dp(60);
                  wm.addView(panel, pp);
              }

              void load() throws Exception {
                  Bitmap bm = ImageDecoder.decodeBitmap(ImageDecoder.createSource(new File(getFilesDir(), "tpl.img")),
                          (dec, info, src) -> {
                              int m = Math.max(info.getSize().getWidth(), info.getSize().getHeight());
                              if (m > 1600) {
                                  float k = 1600f / m;
                                  dec.setTargetSize(Math.round(info.getSize().getWidth() * k),
                                          Math.round(info.getSize().getHeight() * k));
                              }
                          });
                  img.setImageBitmap(bm);
                  aspect = (float) bm.getWidth() / bm.getHeight();
                  float w = Math.min(sw() * .7f, sh() * .6f * aspect);
                  ip.width = Math.round(w);
                  ip.height = Math.round(w / aspect);
                  ip.x = (sw() - ip.width) / 2;
                  ip.y = (sh() - ip.height) / 2;
                  resize(w);
                  setMove(true);
              }

              void resize(float nw) {
                  nw = Math.max(dp(60), Math.min(nw, Math.min(4000f, 4000f * aspect)));
                  float cx = ip.x + ip.width / 2f, cy = ip.y + ip.height / 2f;
                  ip.width = Math.round(nw);
                  ip.height = Math.round(nw / aspect);
                  ip.x = Math.round(cx - ip.width / 2f);
                  ip.y = Math.round(cy - ip.height / 2f);
                  wm.updateViewLayout(img, ip);
                  sbS.setProgress(Math.round((nw / sw() - .1f) / 2.9f * 100));
              }

              void applyFlags() {
                  ip.flags = FL | ((move && !hidden) ? 0 : LayoutParams.FLAG_NOT_TOUCHABLE);
                  wm.updateViewLayout(img, ip);
              }

              void setMove(boolean m) {
                  move = m;
                  applyFlags();
                  bMove.setText(m ? "✏️ Рисовать" : "✋ Двигать");
                  Toast.makeText(this, m ? "Палец двигает фото, два пальца меняют размер"
                          : "Рисуй: касания проходят сквозь фото", Toast.LENGTH_SHORT).show();
              }

              Button btn(String s, View.OnClickListener l) {
                  Button b = new Button(this);
                  b.setText(s);
                  b.setAllCaps(false);
                  b.setTextColor(0xFFFFFFFF);
                  b.setTextSize(13);
                  b.setMinWidth(0);
                  b.setMinimumWidth(0);
                  b.setMinHeight(0);
                  b.setMinimumHeight(0);
                  b.setPadding(dp(8), dp(8), dp(8), dp(8));
                  GradientDrawable g = new GradientDrawable();
                  g.setColor(0xFF4A2F85);
                  g.setCornerRadius(dp(10));
                  b.setBackground(g);
                  b.setOnClickListener(l);
                  return b;
              }

              TextView label(String s) {
                  TextView t = new TextView(this);
                  t.setText(s);
                  t.setTextColor(0xFFFFFFFF);
                  t.setTextSize(12);
                  t.setPadding(0, dp(8), 0, 0);
                  return t;
              }
          }
          JAVAEOF
      - name: Build APK
        run: gradle assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: TraceOverlay-APK
          path: app/build/outputs/apk/debug/app-debug.apk
      - name: Publish release
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release create "v${{ github.run_number }}" app/build/outputs/apk/debug/app-debug.apk --repo "${{ github.repository }}" --title "APK ${{ github.run_number }}" --notes "Debug APK"
